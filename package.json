{
  "name": "zimanyar-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Offline grammar checker and teacher for Kurdish (Sorani and Kurmanji)",
  "license": "GPL-3.0-or-later",
  "author": "Dolan H. <0xdolan@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xdolan/Zimanyar.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.21.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^22",
    "axe-core": "4.14.0",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  }
}
