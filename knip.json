{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "scripts": {
      "entry": ["checks/*.ts", "brand/*.ts", "brand/*.mjs", "marketing/*.js", "content/*.ts", "corpus/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/components/ui/*.tsx", "demo/*.{ts,tsx}"]
    },
    ".": {
      "ignoreDependencies": ["axe-core"]
    }
  },
  "ignore": ["packages/core/src/generated/**"]
}
