{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick",
  "description": "The quick window: the clipboard, which is what it is for, and hiding itself.",
  "windows": ["quick"],
  "permissions": [
    "core:event:default",
    "core:window:allow-hide",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
