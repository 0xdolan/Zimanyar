---
import { createT, type UiLang } from "@zimanyar/i18n";
import SitePage from "../../components/SitePage.astro";
import { localePaths } from "../../lib/site";

export const getStaticPaths = localePaths;
const lang = Astro.props.lang as UiLang;
const t = createT(lang);
const parts = [
  [t("licences.code"), "GPL-3.0-or-later", "https://github.com/0xdolan/Zimanyar/blob/main/LICENSE"],
  [t("licences.data"), "CC BY-SA 4.0", "https://github.com/0xdolan/Zimanyar/blob/main/packages/data/NOTICE"],
  [t("licences.lessons"), "GPL-3.0-or-later", "https://github.com/0xdolan/zimankit"],
  [t("licences.fonts"), "OFL-1.1", "https://github.com/0xdolan/Zimanyar/blob/main/NOTICE"],
];
---

<SitePage title={t("licences.title")} description={t("licences.description")}>
  <table>
    <thead>
      <tr><th scope="col">{t("licences.part")}</th><th scope="col">{t("licences.licence")}</th></tr>
    </thead>
    <tbody>
      {parts.map(([part, licence, href]) => <tr><td>{part}</td><td dir="ltr"><a href={href}>{licence}</a></td></tr>)}
    </tbody>
  </table>
  <p>{t("licences.others")} <a href="https://github.com/0xdolan/Zimanyar/blob/main/NOTICE">NOTICE</a></p>
</SitePage>
