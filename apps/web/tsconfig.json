{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "astro.config.ts"],
  "exclude": ["dist"]
}
