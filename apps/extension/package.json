{
  "name": "@zimanyar/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Zimanyar for Chrome, Firefox and Safari",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@wxt-dev/module-react": "1.2.2",
    "@zimanyar/config": "workspace:*",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  },
  "scripts": {
    "prebuild": "tsx scripts/prepare.ts",
    "build": "wxt build && wxt build -b firefox --mv3",
    "build:e2e": "tsx scripts/prepare.ts && ZIMANYAR_E2E=1 wxt build",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "wxt prepare && vitest run",
    "test:coverage": "wxt prepare && vitest run --coverage"
  },
  "dependencies": {
    "@zimanyar/checker": "workspace:*",
    "@zimanyar/content": "workspace:*",
    "@zimanyar/core": "workspace:*",
    "@zimanyar/data": "workspace:*",
    "@zimanyar/editor": "workspace:*",
    "@zimanyar/i18n": "workspace:*",
    "@zimanyar/rules": "workspace:*",
    "@zimanyar/settings": "workspace:*",
    "@zimanyar/ui": "workspace:*",
    "@fontsource/vazirmatn": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
