{
  "name": "zimanyar",
  "version": "0.1.0",
  "description": "Offline grammar checker and teacher for Kurdish (Sorani and Kurmanji), for the command line",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "homepage": "https://0xdolan.github.io/Zimanyar/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xdolan/Zimanyar.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/0xdolan/Zimanyar/issues",
  "keywords": [
    "kurdish",
    "sorani",
    "kurmanji",
    "grammar",
    "spelling",
    "linter",
    "sarif",
    "language-server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "zimanyar": "dist/zimanyar.cjs",
    "zimanyar-lsp": "dist/zimanyar-lsp.cjs"
  },
  "files": [
    "dist/zimanyar.cjs",
    "dist/zimanyar-lsp.cjs",
    "dist/data",
    "dist/THIRD-PARTY-NOTICES.txt",
    "man"
  ],
  "scripts": {
    "prepare-assets": "tsx --tsconfig ../../packages/content/tsconfig.json scripts/prepare.ts",
    "build": "pnpm prepare-assets && tsx scripts/build.ts",
    "start": "pnpm prepare-assets && tsx src/main.ts",
    "typecheck": "pnpm prepare-assets && tsc --noEmit",
    "test": "pnpm prepare-assets && vitest run",
    "test:coverage": "pnpm prepare-assets && vitest run --coverage"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@types/hast": "3.0.5",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@zimanyar/app": "workspace:*",
    "@zimanyar/checker": "workspace:*",
    "@zimanyar/config": "workspace:*",
    "@zimanyar/content": "workspace:*",
    "@zimanyar/core": "workspace:*",
    "@zimanyar/data": "workspace:*",
    "@zimanyar/i18n": "workspace:*",
    "@zimanyar/rules": "workspace:*",
    "@zimanyar/settings": "workspace:*",
    "esbuild": "0.28.2",
    "hast-util-from-html": "2.0.3",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16"
  }
}
