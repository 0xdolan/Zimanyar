{
  "name": "@zimanyar/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Underlines, the finding card and autocomplete on any text field",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "demo:build": "vite build demo --config demo/vite.config.ts",
    "demo:serve": "vite preview demo --config demo/vite.config.ts --port 4174 --strictPort"
  },
  "dependencies": {
    "@zimanyar/i18n": "workspace:*",
    "@zimanyar/rules": "workspace:*",
    "@zimanyar/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@zimanyar/checker": "workspace:*",
    "@zimanyar/config": "workspace:*",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
