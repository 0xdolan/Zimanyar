    "contextual_rules": [
      {
        "id": "initial_r",
        "rule": "word-initial ر -> ڕ",
        "example": [
          "رۆژ",
          "ڕۆژ"
        ]
      },
      {
        "id": "initial_hamza",
        "rule": "word-initial vowel letter gets ئ",
        "example": [
          "ەمە",
          "ئەمە"
        ]
      },
      {
        "id": "legacy_ae",
        "rule": "ه + ZWNJ -> ە; in legacy-encoded text word-final ه -> ە",
        "example": [
          "به‌ڕێوه‌به‌ر",
          "بەڕێوەبەر"
        ]
      },
      {
        "id": "zwnj",
        "rule": "micro-spaces -> ZWNJ; ZWNJ kept only between two joining letters"
      },
      {
        "id": "squeeze",
        "rule": "ەە -> ە, ڕڕ -> ڕ, ڵڵ -> ڵ, ووو -> وو"
      }
    ]
  },
