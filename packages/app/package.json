{
  "name": "@zimanyar/app",
  "version": "0.1.0",
  "private": true,
  "description": "The complete Zimanyar app, for the extension's full view and the desktop app",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./vite.ts",
    "./page.css": "./src/page.css",
    "./overlay.css": "./src/overlay.css",
    "./routes": "./src/routes.ts",
    "./writing": "./src/writing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
