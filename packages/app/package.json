  "dependencies": {
    "@fontsource/vazirmatn": "5.3.0",
    "@mdx-js/rollup": "3.1.1",
    "@zimanyar/content": "workspace:*",
    "@zimanyar/core": "workspace:*",
    "@zimanyar/editor": "workspace:*",
    "@zimanyar/i18n": "workspace:*",
    "@zimanyar/rules": "workspace:*",
    "@zimanyar/settings": "workspace:*",
    "@zimanyar/ui": "workspace:*",
    "react": "19.3.1",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@zimanyar/config": "workspace:*",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
