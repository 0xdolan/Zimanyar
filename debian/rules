#!/usr/bin/make -f
# The package holds one program: Node.js with the bundled command line and the lexicons inside it,
# built by make cli-sea. Its tests run in CI, where pnpm is available.
#
# The source package for the Launchpad PPA (packaging/ppa/build-source.sh) carries the released
# executables in prebuilt/ARCH instead, because Launchpad builds without a network and without pnpm.

include /usr/share/dpkg/architecture.mk

PREBUILT := $(wildcard prebuilt/$(DEB_HOST_ARCH))
BIN_DIR := $(or $(PREBUILT),apps/cli/dist)
NODE_LICENSE := $(if $(PREBUILT),$(PREBUILT)/NODE-LICENSE.txt,$(dir $(realpath $(shell command -v node)))../LICENSE)

%:
	dh $@

override_dh_auto_clean:

override_dh_auto_configure:

override_dh_auto_build:
	test -n "$(PREBUILT)" || test -x apps/cli/dist/zimanyar || $(MAKE) cli-sea

override_dh_auto_test:

override_dh_auto_install:
	install -D -m 0755 $(BIN_DIR)/zimanyar debian/zimanyar-cli/usr/bin/zimanyar
	install -D -m 0755 packaging/cli/zimanyar-lsp debian/zimanyar-cli/usr/bin/zimanyar-lsp
	install -D -m 0644 $(BIN_DIR)/THIRD-PARTY-NOTICES.txt debian/zimanyar-cli/usr/share/doc/zimanyar-cli/THIRD-PARTY-NOTICES.txt
	install -D -m 0644 $(NODE_LICENSE) debian/zimanyar-cli/usr/share/doc/zimanyar-cli/NODE-LICENSE.txt

# Stripping, or moving debug data out, would cut away the bundle that is injected into the program.
override_dh_strip:

override_dh_dwz:
