{
  "extends": "@zimanyar/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "brand/**/*.ts",
    "content/**/*.ts",
    "checks/**/*.ts",
    "data/**/*.ts",
    "release/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
